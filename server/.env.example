DATABASE_URL="postgresql://user:password@localhost:5432/pronote_mmi"
JWT_SECRET="change_this_secret"

# URL(s) du frontend autorisée(s) en CORS (séparées par des virgules si plusieurs)
CLIENT_ORIGIN="http://localhost:5173"

# Clés VAPID pour les notifications push
# Générer avec : npx web-push generate-vapid-keys
VAPID_EMAIL="ton@email.com"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Clé API Resend (https://resend.com) pour l'envoi des emails de réinitialisation
# de mot de passe. Sans elle, le serveur démarre quand même mais l'envoi échoue.
RESEND_API_KEY=""
